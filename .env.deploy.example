# Generate .env.deploy with: python3 deploy/init-env.py
# Blank secrets deliberately prevent an accidental start with example credentials.
DEPLOY_DB_NAME=leap_trading
DEPLOY_DB_USERNAME=leap_app
DEPLOY_DB_PASSWORD=
DEPLOY_POSTGRES_PASSWORD=
DEPLOY_JWT_SECRET=
DEPLOY_INTERNAL_ACCESS_CODE=

# Local container trial. For a cloud hostname, see docs/container-deployment.md.
APP_BIND_ADDRESS=127.0.0.1
APP_HTTP_PORT=8082
APP_HTTPS_PORT=8443
APP_SITE_ADDRESS=http://:80
APP_CORS_ALLOWED_ORIGINS=http://localhost:8082

# Use immutable release tags here when pulling images from a registry.
LEAP_IMAGE_PREFIX=leap
LEAP_IMAGE_TAG=local

TRADING_MEMORY_LIMIT=1g
MARKET_MEMORY_LIMIT=512m
FRONTEND_MEMORY_LIMIT=256m
REPORTING_BACKFILL_ENABLED=false
