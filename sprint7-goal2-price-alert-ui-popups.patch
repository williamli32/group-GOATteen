+.notification-card { flex-wrap: nowrap; }
+.notification-card.unread { border-color: rgba($accent,.42); background: #122631; }
+.notification-indicator { flex: 0 0 6px; align-self: flex-start; margin-top: 7px; width: 6px; height: 6px; border-radius: 50%; background: #64748b; }
+.unread .notification-indicator { background: $accent; }
+.notification-detail strong { overflow-wrap: anywhere; font-size: 12px; }
+.notification-detail p { font-size: 11px; }
+.notification-detail small { display: block; margin-top: 6px; color: $muted; font-size: 10px; }
+.read-label { color: $muted; font-size: 11px; }
+.empty-state { display: block; padding: 20px; border: 1px dashed $border; border-radius: 5px; color: $muted; font-size: 12px; line-height: 1.7; }
+@media (max-width: 850px) { .alert-fields { grid-template-columns: minmax(0, 1fr); } }
+@media (max-width: 500px) { .price-alerts { padding: 12px; } .alerts-header { flex-wrap: wrap; } .card-actions { width: 100%; } .notification-card { flex-wrap: wrap; } }
+@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto; } }
