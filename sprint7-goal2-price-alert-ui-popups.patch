+.status-triggered { color: #f2c879; border-color: rgba(#f2c879,.4); background: rgba(#f2c879,.08); }
+.alert-condition strong { color: $text; }
+.alert-meta { display: block; margin-top: 5px; color: $muted; font-size: 11px; }
+.card-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
+.notifications-heading { margin-bottom: 5px; }
