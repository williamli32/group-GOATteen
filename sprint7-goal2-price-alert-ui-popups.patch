+.alert-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
+.alert-card, .notification-card { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; min-width: 0; padding: 14px; border-radius: 6px; border: 1px solid $border; background: $inner; }
