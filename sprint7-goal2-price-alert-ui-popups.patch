+<section class="price-alerts" aria-labelledby="price-alerts-heading" [attr.aria-busy]="loading() || busy()">
+  <header class="alerts-header">
+    <div>
+      <div class="eyebrow">AUTOMATED MARKET MONITORING</div>
+      <h2 id="price-alerts-heading">Price alerts</h2>
+      <p>Set a target and we'll watch the market for you, even while you're signed out.</p>
+    </div>
+    <span class="active-count">{{ activeCount() }} active</span>
+  </header>
+
+  <form class="alert-form" (ngSubmit)="save()" aria-label="Price alert settings">
+    <div class="form-title">
+      <strong>{{ editId === null ? 'Create a price alert' : 'Edit price alert' }}</strong>
+      <span>One notification per activation</span>
+    </div>
+    <div class="alert-fields">
+      <div class="field">
+        <label for="alert-instrument">Instrument</label>
+        <select id="alert-instrument" name="instrument" [(ngModel)]="instrumentId" required [disabled]="busy()">
+          <option [ngValue]="null">Select an instrument</option>
+          @for (instrument of instruments(); track instrument.instrumentId) {
+            <option [ngValue]="instrument.instrumentId">
+              {{ instrument.symbol }} · {{ instrument.exchange }} · {{ instrument.currency }}
+            </option>
+          }
+        </select>
+      </div>
+      <div class="field">
+        <label for="alert-direction">Notify me when</label>
+        <select id="alert-direction" name="direction" [(ngModel)]="direction" [disabled]="busy()">
+          <option value="ABOVE">Price is at or above</option>
+          <option value="BELOW">Price is at or below</option>
+        </select>
+      </div>
+      <div class="field">
+        <label for="alert-threshold">Target price ({{ selectedInstrument()?.currency ?? 'quote currency' }})</label>
+        <input id="alert-threshold" name="threshold" type="number" min="0.00000001" step="any"
+          [(ngModel)]="threshold" placeholder="e.g. 200.00" required [disabled]="busy()" />
+      </div>
+    </div>
+    @if (selectedInstrument(); as instrument) {
+      <p class="quote-hint">
+        {{ instrument.symbol }} · {{ instrument.currency }}
+        @if (instrument.latestQuote; as quote) {
+          · Latest {{ quote.lastPrice | number:'1.2-8' }} {{ instrument.currency }}
+          · {{ quote.quotedAt | date:'MMM d, HH:mm:ss' }}
+        } @else {
+          · Latest price unavailable
+        }
+      </p>
+    }
+    <div class="form-actions">
+      <button type="submit" class="primary-button"
+        [disabled]="busy() || instrumentId === null || (threshold ?? 0) <= 0">
+        {{ busy() ? 'Saving...' : editId === null ? 'Create alert' : 'Save and reactivate' }}
+      </button>
+      @if (editId !== null) {
+        <button type="button" class="secondary-button" (click)="reset()" [disabled]="busy()">Cancel editing</button>
+      }
+    </div>
+  </form>
+
+  @if (error()) { <p class="feedback error" role="alert">{{ error() }}</p> }
+  @if (info()) { <p class="feedback success" role="status">{{ info() }}</p> }
+
+  <div class="list-heading">
+    <div>
+      <h3>My price alerts</h3>
+      <span>{{ alerts().length }} saved</span>
+    </div>
+    <button type="button" class="text-button" (click)="reload()" [disabled]="busy() || loading()">
+      {{ loading() ? 'Refreshing...' : 'Refresh' }}
+    </button>
+  </div>
+  <ul class="alert-list">
+    @for (alert of alerts(); track alert.id) {
+      <li class="alert-card">
+        <div class="alert-details">
+          <div class="alert-card-top">
+            <strong>{{ alert.symbol }}</strong>
+            <span class="status" [class.status-active]="alert.enabled"
+              [class.status-triggered]="alert.triggeredAt !== null">
+              {{ alert.triggeredAt ? 'Triggered' : alert.enabled ? 'Active' : 'Paused' }}
+            </span>
+          </div>
+          <p class="alert-condition">
+            {{ alert.direction === 'ABOVE' ? 'At or above' : 'At or below' }}
+            <strong>{{ alert.threshold | number:'1.2-8' }} {{ alert.currency }}</strong>
+          </p>
+          @if (alert.triggeredAt) {
+            <span class="alert-meta">Triggered {{ alert.triggeredAt | date:'medium' }} · Reactivate to monitor again</span>
+          } @else {
+            <span class="alert-meta">{{ alert.enabled ? 'Monitoring the market' : 'Monitoring paused' }}</span>
+          }
+        </div>
+        <div class="card-actions">
+          <button type="button" class="secondary-button" (click)="edit(alert)" [disabled]="busy()">Edit</button>
+          <button type="button" class="secondary-button" (click)="toggle(alert)" [disabled]="busy()">
+            {{ alert.enabled ? 'Pause' : 'Reactivate' }}
+          </button>
+          <button type="button" class="danger-button" (click)="remove(alert)" [disabled]="busy()"
+            [attr.aria-label]="'Delete price alert for ' + alert.symbol">Delete</button>
+        </div>
+      </li>
+    } @empty {
+      <li class="empty-state">No alerts yet. Create your first alert above to start monitoring a price.</li>
+    }
+  </ul>
+
+  <div class="list-heading notifications-heading">
+    <div>
+      <h3>Triggered notifications</h3>
+      <span>{{ unreadCount() }} unread</span>
+    </div>
+  </div>
+  <p class="list-description">Alerts appear as dashboard popups and are saved here for when you return.</p>
+  <ul class="alert-list notification-history">
+    @for (notice of notices(); track notice.id) {
+      <li class="notification-card" [class.unread]="!notice.readAt">
+        <span class="notification-indicator" aria-hidden="true"></span>
+        <div class="notification-detail">
+          <strong>{{ notice.symbol }} {{ notice.direction === 'ABOVE' ? 'reached your upper target' : 'reached your lower target' }}</strong>
+          <p>{{ notice.observedPrice | number:'1.2-8' }} {{ notice.currency }} observed
+            · Target {{ notice.threshold | number:'1.2-8' }} {{ notice.currency }}</p>
+          <small>{{ notice.quoteAt | date:'medium' }}</small>
+        </div>
+        @if (!notice.readAt) {
+          <button type="button" class="secondary-button" (click)="markRead(notice)"
+            [attr.aria-label]="'Mark ' + notice.symbol + ' price alert as read'">Mark read</button>
+        } @else {
+          <span class="read-label">Read</span>
+        }
+      </li>
+    } @empty {
+      <li class="empty-state">No alerts have triggered yet. We'll keep checking the market.</li>
+    }
+  </ul>
 </section>
