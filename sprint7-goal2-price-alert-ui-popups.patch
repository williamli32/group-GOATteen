+.active-count { flex-shrink: 0; padding: 6px 10px; color: $accent; background: rgba($accent, .09); border: 1px solid rgba($accent, .3); border-radius: 4px; font-size: 11px; }
+.alert-form { margin-top: 18px; padding: 16px; border: 1px solid $border; border-radius: 6px; background: $inner; }
+.form-title { flex-wrap: wrap; margin-bottom: 16px; align-items: center; }
+.form-title strong { color: $text; font-size: 14px; }
+.form-title span { color: $muted; font-size: 11px; }
+.alert-fields { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
+.field { display: flex; flex-direction: column; min-width: 0; gap: 8px; }
+label { font-size: 11px; color: $muted; }
+select, input { width: 100%; min-width: 0; min-height: 42px; padding: 10px 12px; color: $text; border: 1px solid #365064; border-radius: 5px; background: #080f1c; box-sizing: border-box; font-size: 12px; }
+select:disabled, input:disabled { opacity: .65; }
+.quote-hint { padding-top: 10px; color: #a7efdf; font-size: 11px; }
+.form-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
