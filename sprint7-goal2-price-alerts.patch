@@ -0,0 +1,71 @@
+package com.goatteen.trading.alerts;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.jdbc.core.JdbcTemplate;
+import java.time.LocalDateTime;
+
+@Service
+public class PriceAlertEvaluator {
+    private static final Logger log=LoggerFactory.getLogger(PriceAlertEvaluator.class);
+    private final JdbcTemplate jdbc;
+    private final int maxQuoteAgeSeconds;
+    public PriceAlertEvaluator(JdbcTemplate jdbc,
+          @Value("${app.price-alerts.max-quote-age-seconds:30}") int maxQuoteAgeSeconds) {
+        this.jdbc=jdbc; this.maxQuoteAgeSeconds=maxQuoteAgeSeconds;
+    }
+
+    /** Called independently of any browser session. Each successful row update and
+      * the durable notification occur in a single database transaction. */
+    @Scheduled(fixedDelayString="${app.price-alerts.check-ms:3000}",
+               initialDelayString="${app.price-alerts.initial-delay-ms:5000}")
+    @Transactional
+    public void evaluate() {
+        // With multiple application instances, SKIP LOCKED prevents duplicate
+        // processing. We only inspect the latest quote per instrument.
+        var rows=jdbc.query("""
+            SELECT a.id,a.user_id,a.generation,a.instrument_id,a.direction,a.threshold,
+                   i.symbol,i.currency,q.id AS quote_id,q.last_price,q.quoted_at
+            FROM price_alerts a JOIN instruments i ON i.id=a.instrument_id
+            JOIN LATERAL (
+                SELECT id,last_price,quoted_at FROM market_quotes
+                WHERE instrument_id=a.instrument_id
+                ORDER BY quoted_at DESC,id DESC LIMIT 1
+            ) q ON TRUE
+            WHERE a.enabled=TRUE AND a.triggered_at IS NULL
+              AND q.quoted_at >= ?
+              AND ((a.direction='ABOVE' AND q.last_price >= a.threshold)
+                OR (a.direction='BELOW' AND q.last_price <= a.threshold))
+            ORDER BY a.id
+            FOR UPDATE OF a SKIP LOCKED
+            """,(r,n)->new Hit(r.getLong(1),r.getLong(2),r.getInt(3),r.getLong(4),
+              r.getString(5),r.getBigDecimal(6),r.getString(7),r.getString(8),
+              r.getLong(9),r.getBigDecimal(10),r.getTimestamp(11).toLocalDateTime()),
+              LocalDateTime.now().minusSeconds(maxQuoteAgeSeconds));
+        for (Hit h:rows) {
+            int updated=jdbc.update("""
+                UPDATE price_alerts SET triggered_at=CURRENT_TIMESTAMP,enabled=FALSE,
+                    updated_at=CURRENT_TIMESTAMP
+                WHERE id=? AND generation=? AND enabled=TRUE AND triggered_at IS NULL
+                """,h.id,h.generation);
+            if(updated==1) {
+                jdbc.update("""
+                    INSERT INTO price_alert_notifications
+                      (alert_id,user_id,generation,instrument_id,symbol,direction,threshold,
+                       observed_price,quote_currency,quote_id,quote_at)
+                    VALUES(?,?,?,?,?,?,?,?,?,?,?)
+                    ON CONFLICT (alert_id,generation) DO NOTHING
+                    """,h.id,h.userId,h.generation,h.instrumentId,h.symbol,h.direction,
+                       h.threshold,h.price,h.currency,h.quoteId,h.quoteAt);
+            }
+        }
+        if(!rows.isEmpty()) log.debug("Evaluated {} triggered price alerts",rows.size());
+    }
+    private record Hit(long id,long userId,int generation,long instrumentId,
+                       String direction,java.math.BigDecimal threshold,String symbol,
+                       String currency,long quoteId,java.math.BigDecimal price,LocalDateTime quoteAt) {}
+}
diff --git a/backend/trading-platform/src/main/java/com/goatteen/trading/alerts/PriceAlertService.java b/backend/trading-platform/src/main/java/com/goatteen/trading/alerts/PriceAlertService.java
