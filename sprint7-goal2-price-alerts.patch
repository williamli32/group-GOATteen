+<section class="price-alerts" aria-labelledby="alerts-heading">
+<h2 id="alerts-heading">Persistent price alerts</h2>
+<p>Alerts use each instrument's quote currency and last price. They are checked on the server even when you are signed out. Each alert fires once until you reactivate it.</p>
+<form (ngSubmit)="save()" class="alert-form">
+ <label for="alert-instrument">Instrument</label>
+ <select id="alert-instrument" name="instrument" [(ngModel)]="instrumentId" required>
+  <option [ngValue]="null">Choose instrument</option>
+  @for (i of instruments();track i.instrumentId) {
+   <option [ngValue]="i.instrumentId">{{i.symbol}} · {{i.exchange}} ({{i.currency}})</option>
+  }
+ </select>
+ <label for="alert-direction">Condition</label>
+ <select id="alert-direction" name="direction" [(ngModel)]="direction">
+  <option value="ABOVE">Price at or above</option><option value="BELOW">Price at or below</option>
+ </select>
+ <label for="alert-threshold">Threshold (instrument quote currency)</label>
+ <input id="alert-threshold" name="threshold" type="number" min="0.00000001" step="any" required [(ngModel)]="threshold" />
+ <button type="submit" [disabled]="busy() || instrumentId===null || threshold===null">{{editId===null?'Create alert':'Save and reactivate alert'}}</button>
+ @if(editId!==null){<button type="button" (click)="reset()">Cancel edit</button>}
+</form>
+@if(error()){<p role="alert" class="error">{{error()}}</p>}
+@if(info()){<p role="status">{{info()}}</p>}
+<h3>Your alerts</h3>
+<button type="button" (click)="reload()" [disabled]="busy() || loading()">Refresh alerts</button>
+<ul>
+@for(a of alerts();track a.id){
+<li>
+ <strong>{{a.symbol}} ({{a.currency}})</strong> {{a.direction==='ABOVE'?'≥':'≤'}} {{a.threshold | number:'1.2-8'}} ·
+ {{a.triggeredAt?'Triggered':a.enabled?'Active':'Disabled'}}
+ <button type="button" (click)="edit(a)" [disabled]="busy()">Edit</button>
+ <button type="button" (click)="toggle(a)" [disabled]="busy()">{{a.enabled?'Disable':'Reactivate'}}</button>
+ <button type="button" (click)="remove(a)" [disabled]="busy()">Delete</button>
+</li>
+} @empty {<li>No alerts created yet.</li>}
+</ul>
+<h3>Triggered notifications</h3>
+<p>Saved notifications remain available after you close your browser. Recent notifications update automatically.</p>
+<ul>
+@for(n of notices();track n.id){
+<li [class.unread]="!n.readAt">
+ {{n.symbol}} {{n.direction==='ABOVE'?'reached or exceeded':'fell to or below'}} {{n.threshold | number:'1.2-8'}} {{n.currency}}.
+ Last price {{n.observedPrice | number:'1.2-8'}} {{n.currency}} at {{n.quoteAt | date:'medium'}}.
+ @if(!n.readAt){<button type="button" (click)="markRead(n)">Mark read</button>}
+</li>
+} @empty {<li>No alerts have triggered.</li>}
+</ul>
+</section>
