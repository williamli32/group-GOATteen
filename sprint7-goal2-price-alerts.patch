diff --git a/frontend/src/app/dashboard/price-alerts.component.ts b/frontend/src/app/dashboard/price-alerts.component.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/app/dashboard/price-alerts.component.ts
@@ -0,0 +1,77 @@
+import { CommonModule } from '@angular/common';
+import { Component, DestroyRef, inject, input, OnInit, signal } from '@angular/core';
+import { takeUntilDestroyed } from '@angular/core/rxjs-interop';
+import { FormsModule } from '@angular/forms';
+import { forkJoin, interval, switchMap, catchError, of } from 'rxjs';
+import { MarketInstrumentResponse } from '../core/services/market-data';
+import { AlertDirection, PriceAlert, PriceAlertChange, PriceAlertsService, PriceNotice } from '../core/services/price-alerts';
+
+@Component({
+  selector:'app-price-alerts',standalone:true,
+  imports:[CommonModule,FormsModule],
+  templateUrl:'./price-alerts.component.html',styleUrl:'./price-alerts.component.scss'
+})
+export class PriceAlertsComponent implements OnInit {
+  readonly instruments=input<MarketInstrumentResponse[]>([]);
+  readonly alerts=signal<PriceAlert[]>([]);
+  readonly notices=signal<PriceNotice[]>([]);
+  readonly loading=signal(false);
+  readonly busy=signal(false);
+  readonly error=signal('');
+  readonly info=signal('');
+  instrumentId:number|null=null;
+  direction:AlertDirection='ABOVE';
+  threshold:number|null=null;
+  editId:number|null=null;
+  private readonly api=inject(PriceAlertsService);
+  private readonly destroyRef=inject(DestroyRef);
+
+  ngOnInit():void {
+    this.reload();
+    interval(5000).pipe(takeUntilDestroyed(this.destroyRef),
+      switchMap(()=>this.api.notifications().pipe(catchError(()=>of(null))))
+    ).subscribe(notes=>{if(notes!==null)this.notices.set(notes);});
+  }
+  reload():void {
+    this.loading.set(true);this.error.set('');
+    forkJoin({alerts:this.api.list(),notices:this.api.notifications()})
+      .pipe(takeUntilDestroyed(this.destroyRef))
+      .subscribe({next:r=>{this.alerts.set(r.alerts);this.notices.set(r.notices);this.loading.set(false);},
+        error:()=>{this.error.set('Could not load saved alerts. Please retry.');this.loading.set(false);}});
+  }
+  edit(a:PriceAlert):void {
+    this.editId=a.id;this.instrumentId=a.instrumentId;this.direction=a.direction;
+    this.threshold=a.threshold;this.error.set('');this.info.set('Editing alert #'+a.id);
+  }
+  reset():void {this.editId=null;this.instrumentId=null;this.direction='ABOVE';this.threshold=null;}
+  save():void {
+    const id=Number(this.instrumentId),v=Number(this.threshold);
+    if(!Number.isInteger(id)||id<1||!Number.isFinite(v)||v<=0||
+       !this.instruments().some(i=>i.instrumentId===id)) {
+      this.error.set('Choose an instrument and a positive threshold.');return;
+    }
+    const body:PriceAlertChange={instrumentId:id,direction:this.direction,threshold:v,enabled:true};
+    this.busy.set(true);this.error.set('');this.info.set('');
+    const req=this.editId===null?this.api.create(body):this.api.update(this.editId,body);
+    req.pipe(takeUntilDestroyed(this.destroyRef)).subscribe({next:()=>{
+      this.busy.set(false);this.info.set('Alert saved. It will trigger once until reactivated.');
+      this.reset();this.reload();},error:()=>{this.busy.set(false);this.error.set('Could not save alert.');}});
+  }
+  toggle(a:PriceAlert):void {
+    this.busy.set(true);this.error.set('');
+    this.api.enabled(a.id,!a.enabled).pipe(takeUntilDestroyed(this.destroyRef)).subscribe({
+      next:()=>{this.busy.set(false);this.reload();},
+      error:()=>{this.busy.set(false);this.error.set('Could not update alert.');}});
+  }
+  remove(a:PriceAlert):void {
+    this.busy.set(true);this.error.set('');
+    this.api.delete(a.id).pipe(takeUntilDestroyed(this.destroyRef)).subscribe({
+      next:()=>{this.busy.set(false);if(this.editId===a.id)this.reset();this.reload();},
+      error:()=>{this.busy.set(false);this.error.set('Could not delete alert.');}});
+  }
+  markRead(n:PriceNotice):void {
+    this.api.read(n.id).pipe(takeUntilDestroyed(this.destroyRef)).subscribe({
+      next:()=>this.notices.update(items=>items.map(i=>i.id===n.id?{...i,readAt:new Date().toISOString()}:i)),
+      error:()=>this.error.set('Could not mark notification as read.')});
+  }
+}
