# Container-only health endpoint, independent of the public hostname and TLS.
http://127.0.0.1:8082 {
	bind 127.0.0.1
	respond /healthz "ok" 200
}

{$SITE_ADDRESS:http://:80} {
	root * /srv
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@api path /api /api/*
	handle @api {
		header Cache-Control no-store
		reverse_proxy trading-platform:8080 {
			# Caddy supplies trusted X-Forwarded-For/Host/Proto. Remove other
			# forwarding headers supplied by a client before Spring sees them.
			header_up -Forwarded
			header_up -X-Forwarded-Port
			header_up -X-Forwarded-Prefix
			header_up -X-Forwarded-Ssl
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	# Management and API documentation are not public application routes.
	@management path /actuator /actuator/* /swagger-ui /swagger-ui/* /swagger-ui.html /v3/api-docs /v3/api-docs/*
	handle @management {
		respond "Not found" 404
	}

	@assets path_regexp assets \.(js|css|ico|svg|png|jpe?g|webp|woff2?|ttf|map)$
	handle @assets {
		@hashed path_regexp hashed -[A-Za-z0-9_-]{8,}\.(js|css)$
		route {
			header Cache-Control "public, max-age=3600"
			header @hashed Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}

	handle {
		header Cache-Control no-store
		try_files {path} /index.html
		file_server
	}
}
